APP_NAME=brd-knowledge
APP_ENV=local
DATABASE_URL=postgresql+psycopg://brd_knowledge:brd_knowledge@localhost:5433/brd_knowledge
LOG_LEVEL=INFO
ALLOWED_DOCUMENT_EXTENSIONS=[".pdf"]
MAX_UPLOAD_SIZE_BYTES=26214400
SOURCE_STORAGE_DIR=data/source_files
EMBEDDING_MODEL_NAME=Alibaba-NLP/gte-modernbert-base
EMBEDDING_MODEL_REVISION=e7f32e3c00f91d699e8c43b53106206bcc72bb22
EMBEDDING_DIMENSION=768
EMBEDDING_MAX_SEQUENCE_LENGTH=8192
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu
EMBEDDING_PREPROCESSING_VERSION=1
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_MODEL_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
RERANKER_MAX_SEQUENCE_LENGTH=512
RERANKER_BATCH_SIZE=16
RERANKER_DEVICE=cpu
RERANKER_CANDIDATE_K=40

# Set the real key only in the ignored .env or injected environment.
GEMINI_API_KEY=replace-with-your-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=1.0
GEMINI_TIMEOUT_SECONDS=60
GEMINI_SAFETY_MARGIN_TOKENS=128

# Gemini is the application default. Choose local_qwen for free local development;
# the frontend selector and CLI --provider can override this per question.
LLM_PROVIDER=gemini
LOCAL_QWEN_MODEL=qwen3:8b
LOCAL_QWEN_BASE_URL=http://127.0.0.1:11434
LOCAL_QWEN_CONTEXT_TOKENS=8192
LOCAL_QWEN_TIMEOUT_SECONDS=180
